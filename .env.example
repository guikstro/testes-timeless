# --- Database ---
DATABASE_URL=postgresql://tintim:tintim@localhost:5433/tintim

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=3001

# --- Frontend ---
# Server-to-server (route handlers / Server Components run inside the web
# container in Docker, so this must resolve on the container network there —
# see docker-compose.yml, which overrides it to http://api:3001/api).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
WEB_APP_URL=http://localhost:3000

# Base URL for tracking-link redirects as seen by an end user's browser
# (Section 11). Always the host-facing address — never the internal Docker
# hostname, even when NEXT_PUBLIC_API_URL above points at one.
PUBLIC_TRACKING_BASE_URL=http://localhost:3001

# --- Feature flags (Section 79) ---
WHATSAPP_INTEGRATION_ENABLED=false
META_INTEGRATION_ENABLED=false

# --- WhatsApp / provider CLOUD_API (Fase 3 — obtidas no Meta for Developers) ---
# Só necessárias para conectar um número pela Cloud API oficial. Uma conexão
# por QR Code (provider EVOLUTION, abaixo) não usa nenhuma delas.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- WhatsApp / provider EVOLUTION (Fase 8 — conexão por QR Code) ---
# A Evolution API sobe como container próprio (ver docker-compose.yml). A
# chave abaixo é escolhida por você, não obtida de terceiros: é o que protege
# a API dela, e o mesmo valor é usado pelo container e pela nossa API.
EVOLUTION_API_KEY=dev-evolution-key-change-me
# Como a NOSSA api enxerga a Evolution (hostname da rede do Docker).
EVOLUTION_API_URL=http://evolution:8080
# Segredo compartilhado que autentica os webhooks da Evolution — eles, ao
# contrário dos da Meta, não são assinados. Vai no path da URL registrada.
# Gere com: openssl rand -hex 24
EVOLUTION_WEBHOOK_TOKEN=replace-with-a-random-token
# Como a Evolution enxerga a NOSSA api para entregar os webhooks de mensagem.
# Precisa ser resolvível de dentro do container dela — nunca "localhost".
EVOLUTION_WEBHOOK_URL=http://api:3001/whatsapp-webhook/evolution

# --- Meta Ads / Conversions API (Fase 6-7 — obtidas no Meta Business Suite) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- Encryption at rest for stored OAuth tokens (Section 87) ---
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Webhooks (Section 85) ---
WEBHOOK_SIGNING_ALGORITHM=sha256

# Quantos proxies existem na frente da API (0 = nenhum).
# Só preencha se houver mesmo um balanceador ou CDN na frente: com este valor
# acima de zero sem proxy real, qualquer pessoa pode forjar o próprio IP pelo
# cabeçalho X-Forwarded-For e escapar do limite de requisições.
TRUST_PROXY=0

# De quanto em quanto tempo o gasto das campanhas é buscado na Meta.
# Padrão 60. Abaixo de 5 é ignorado: não é sincronizar, é martelar a API deles.
META_SYNC_INTERVAL_MINUTES=60

# Por quantos dias um aviso já entregue fica no histórico do sino.
# Padrão 90, piso de 7. A linha do tempo do lead não é afetada por isto.
NOTIFICATION_RETENTION_DAYS=90

# --- Envio de e-mail ---
# `registro` escreve o e-mail no log e não entrega nada (desenvolvimento).
# `smtp` entrega de verdade. Em produção só `smtp` é aceito: com `registro`,
# quem esquecer a senha fica trancado fora da conta para sempre.
EMAIL_TRANSPORTE=registro
# Quem aparece como remetente. Um domínio que você controla, senão cai em spam.
EMAIL_REMETENTE="Timeless <nao-responda@seudominio.com.br>"
# Qualquer provedor com SMTP serve: SES, Resend, Postmark, Mailgun.
SMTP_HOST=
# 465 usa TLS desde o primeiro byte; 587 sobe para TLS com STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
