generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1: Foundation — auth, organizations, multi-tenant membership
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Fortaleza")
  currency  String   @default("BRL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships   Membership[]
  trackingLinks TrackingLink[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships          Membership[]
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Phase 2: Tracking — trackable links and click capture
// ---------------------------------------------------------------------------

model TrackingLink {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  code            String    @unique
  destinationUrl  String    @map("destination_url")
  defaultSource   String?   @map("default_source")
  defaultMedium   String?   @map("default_medium")
  defaultCampaign String?   @map("default_campaign")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clicks       TrackingClick[]

  @@index([organizationId])
  @@map("tracking_links")
}

model TrackingClick {
  id             String   @id @default(uuid())
  trackingLinkId String   @map("tracking_link_id")
  organizationId String   @map("organization_id")
  clickedAt      DateTime @default(now()) @map("clicked_at")
  landingUrl     String   @map("landing_url")
  referrer       String?
  userAgent      String?  @map("user_agent")

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")

  fbclid   String?
  ctwaClid String? @map("ctwa_clid")
  gclid    String?

  campaignId String? @map("campaign_id")
  adsetId    String? @map("adset_id")
  adId       String? @map("ad_id")

  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([trackingLinkId, clickedAt])
  @@map("tracking_clicks")
}
