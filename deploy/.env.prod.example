# =====================================================================
# Produção gratuita — copie para .env.prod e preencha.
# O script instalar.sh gera as senhas e chaves sozinho se ficarem vazias.
# =====================================================================

# --- Endereços (sem https://) ---
# Sem domínio próprio, use o IP público do servidor com sslip.io (grátis):
#   DOMINIO_APP=app.123.45.67.89.sslip.io
# Com domínio, aponte registros A desses nomes para o IP do servidor.
DOMINIO_APP=
DOMINIO_ADMIN=
DOMINIO_LINK=
# E-mail para o Let's Encrypt avisar sobre certificados.
EMAIL_CERTIFICADO=

# --- Segredos (gerados pelo instalar.sh se vazios) ---
POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Funcionalidades ---
WHATSAPP_INTEGRATION_ENABLED=true
META_INTEGRATION_ENABLED=true
WEBHOOK_SIGNING_ALGORITHM=sha256

# --- E-mail: "registro" mostra o link de recuperação de senha no log da API ---
EMAIL_TRANSPORTE=registro
EMAIL_REMETENTE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Opcionais (preencha quando for usar) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_SYNC_INTERVAL_MINUTES=60
NOTIFICATION_RETENTION_DAYS=90

# --- Backup fora do servidor (opcional, liga o perfil "offsite") ---
# Destino no formato do rclone. Ex. Oracle Object Storage (S3 compatível, grátis até 20 GB):
#   RCLONE_DESTINO=oci:tracking-backups
#   RCLONE_CONFIG_OCI_TYPE=s3
#   RCLONE_CONFIG_OCI_PROVIDER=Other
#   RCLONE_CONFIG_OCI_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_OCI_ENDPOINT=https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
#   RCLONE_CONFIG_OCI_REGION=sa-saopaulo-1
RCLONE_DESTINO=
