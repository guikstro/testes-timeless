generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1: Foundation — auth, organizations, multi-tenant membership
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

/**
 * Níveis do operador da plataforma (Fase 9.2). Ordenados por poder: tudo que
 * o SUPPORT faz, o ADMIN também faz.
 *
 * Não confundir com `MembershipRole`: aquele é o papel de alguém DENTRO de
 * uma organização cliente; este é o papel de quem opera a plataforma.
 */
enum PlatformRole {
  /** Atendimento: lista os clientes e entra nas contas para dar suporte. */
  SUPPORT
  /** Tudo do SUPPORT, mais promover, rebaixar e revogar outros operadores. */
  ADMIN
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Fortaleza")
  currency  String   @default("BRL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships         Membership[]
  trackingLinks       TrackingLink[]
  whatsappConnection  WhatsAppConnection?
  leads               Lead[]
  attributions        Attribution[]
  classificationRules ClassificationRule[]
  sales               Sale[]
  auditLogs           AuditLog[]
  metaConnection      MetaConnection?
  campaigns           Campaign[]
  conversionEvents    ConversionEvent[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  /**
   * Fase 9: nível do operador da plataforma (nós), não do cliente. É um eixo
   * ACIMA de `MembershipRole`, que só vale dentro de uma organização — um
   * operador enxerga todas as organizações e entra em qualquer uma, mesmo
   * sem ter Membership nenhuma.
   *
   * `null` significa "usuário comum", que é o caso da esmagadora maioria:
   * ser operador é a exceção, e nunca é concedido por cadastro público.
   */
  platformRole PlatformRole? @map("platform_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships          Membership[]
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Phase 2: Tracking — trackable links and click capture
// ---------------------------------------------------------------------------

model TrackingLink {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  code            String    @unique
  destinationUrl  String    @map("destination_url")
  defaultSource   String?   @map("default_source")
  defaultMedium   String?   @map("default_medium")
  defaultCampaign String?   @map("default_campaign")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clicks       TrackingClick[]

  @@index([organizationId])
  @@map("tracking_links")
}

model TrackingClick {
  id             String   @id @default(uuid())
  trackingLinkId String   @map("tracking_link_id")
  organizationId String   @map("organization_id")
  clickedAt      DateTime @default(now()) @map("clicked_at")
  landingUrl     String   @map("landing_url")
  referrer       String?
  userAgent      String?  @map("user_agent")

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")

  fbclid   String?
  ctwaClid String? @map("ctwa_clid")
  gclid    String?

  campaignId String? @map("campaign_id")
  adsetId    String? @map("adset_id")
  adId       String? @map("ad_id")

  /**
   * Embedded into the prefilled `text=` of a wa.me redirect (Fase 4) so the
   * first WhatsApp message can be matched back to this exact click — see
   * docs/ATTRIBUTION.md. Null for clicks whose destination isn't WhatsApp.
   */
  attributionToken String? @unique @map("attribution_token")

  trackingLink TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  attribution  Attribution?

  @@index([organizationId])
  @@index([trackingLinkId, clickedAt])
  @@map("tracking_clicks")
}

// ---------------------------------------------------------------------------
// Phase 4: Attribution — connecting a WhatsApp lead back to its origin
// ---------------------------------------------------------------------------

enum AttributionMethod {
  /** Meta's own `referral.ctwa_clid` on a Click-to-WhatsApp ad message — the strongest possible evidence, given directly by Meta. */
  CTWA_REFERRAL
  /** Our own reference token, embedded in a wa.me redirect's prefilled text, matched back to a TrackingClick. */
  TRACKING_LINK
  /** No usable evidence was present on the lead's first message. Never guessed — see docs/ATTRIBUTION.md. */
  UNKNOWN
}

enum AttributionConfidence {
  HIGH
  NONE
}

model Attribution {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  /** One row per lead: first-touch, computed once at lead creation, never overwritten by later messages (Section 31). */
  leadId          String                @unique @map("lead_id")
  method          AttributionMethod
  confidence      AttributionConfidence
  trackingClickId String?               @unique @map("tracking_click_id")
  /** Raw snapshot of the evidence used, for audit ("why was this lead attributed to this campaign?" — Section 46). */
  evidence        Json?
  attributedAt    DateTime              @default(now()) @map("attributed_at")
  createdAt       DateTime              @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  trackingClick TrackingClick? @relation(fields: [trackingClickId], references: [id])

  @@index([organizationId])
  @@map("attributions")
}

// ---------------------------------------------------------------------------
// Phase 3: WhatsApp — connection, leads, conversations, messages, timeline
// ---------------------------------------------------------------------------

/**
 * Fase 8: o transporte do WhatsApp virou plugável. O pipeline de ingestão a
 * jusante (lead -> atribuição -> qualificação -> Conversions API) é
 * idêntico para os dois — só muda como a mensagem chega e como ela sai.
 */
enum WhatsAppProvider {
  /** WhatsApp Business Cloud API oficial da Meta (Fase 3). Sem risco de banimento, exige verificação de negócio. */
  CLOUD_API
  /** Evolution API (QR Code, protocolo do WhatsApp Web). Conecta em minutos, mas é não-oficial — ver docs/WHATSAPP.md. */
  EVOLUTION
}

enum WhatsAppConnectionStatus {
  /** Só EVOLUTION: instância criada, aguardando o usuário ler o QR Code. */
  PENDING_QR
  CONNECTED
  DISCONNECTED
}

model WhatsAppConnection {
  id             String                   @id @default(uuid())
  organizationId String                   @unique @map("organization_id")
  provider       WhatsAppProvider         @default(CLOUD_API)
  status         WhatsAppConnectionStatus @default(CONNECTED)

  /**
   * Chave de roteamento multi-tenant do provider CLOUD_API: todo evento do
   * webhook da Meta carrega `value.metadata.phone_number_id`. Null para
   * conexões EVOLUTION, que roteiam por `instanceName`.
   */
  phoneNumberId String? @unique @map("phone_number_id")

  /**
   * Chave de roteamento multi-tenant do provider EVOLUTION: todo evento do
   * webhook da Evolution carrega `instance`. Null para conexões CLOUD_API.
   */
  instanceName String? @unique @map("instance_name")

  /** Desconhecido até o QR ser lido (EVOLUTION), por isso nullable — a Meta já informa no ato da conexão. */
  displayPhoneNumber   String? @map("display_phone_number")
  accessTokenEncrypted String? @map("access_token_encrypted")

  connectedAt    DateTime  @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  lastEventAt    DateTime? @map("last_event_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("whatsapp_connections")
}

enum LeadStatus {
  NEW
  QUALIFIED
  /** Entre qualificar e vender: existe horário combinado com o lead (Fase 11). */
  MEETING_SCHEDULED
  WON
}

model Lead {
  id              String     @id @default(uuid())
  organizationId  String     @map("organization_id")
  normalizedPhone String     @map("normalized_phone")
  rawPhone        String     @map("raw_phone")
  name            String?
  status          LeadStatus @default(NEW)
  firstContactAt  DateTime   @map("first_contact_at")
  lastContactAt   DateTime   @map("last_contact_at")
  qualifiedAt     DateTime?  @map("qualified_at")
  meetingScheduledAt DateTime? @map("meeting_scheduled_at")
  wonAt           DateTime?  @map("won_at")

  /**
   * Desqualificação é uma saída lateral do funil, não mais um degrau nele —
   * por isso um campo próprio, e não um valor de `status` (Fase 11).
   *
   * Assim o lead preserva o estágio até onde chegou antes de ser descartado
   * ("estava qualificado quando desistiu" é diferente de "nunca engajou"), e
   * a desqualificação pode ser desfeita se a pessoa voltar.
   */
  disqualifiedAt     DateTime? @map("disqualified_at")
  disqualifiedReason String?   @map("disqualified_reason")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  events           LeadEvent[]
  attribution      Attribution?
  sale             Sale?
  conversionEvents ConversionEvent[]

  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, lastContactAt])
  @@map("leads")
}

model Conversation {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  leadId               String   @map("lead_id")
  whatsappConnectionId String   @map("whatsapp_connection_id")
  startedAt            DateTime @default(now()) @map("started_at")
  lastMessageAt        DateTime @default(now()) @map("last_message_at")
  createdAt            DateTime @default(now()) @map("created_at")

  lead               Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  whatsappConnection WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([organizationId])
  @@index([leadId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  OTHER
}

/** Só faz sentido para OUTBOUND — uma mensagem INBOUND, por definição, já chegou. */
enum OutboundStatus {
  /** Persistida e enfileirada, ainda não aceita pelo provider. */
  PENDING
  /** O provider aceitou e devolveu o id externo real. */
  SENT
  /** Todas as tentativas de envio falharam — `sendError` guarda o motivo real. */
  FAILED
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  /**
   * O id do provider. Null enquanto uma mensagem OUTBOUND não foi aceita
   * (só existe depois do envio) — para INBOUND é sempre preenchido, e é a
   * chave de idempotência contra reentregas do webhook. Postgres permite
   * múltiplos NULLs num índice único, então isso não colide.
   */
  externalId     String?          @unique @map("external_id")
  direction      MessageDirection
  type           MessageType
  text           String?
  timestamp      DateTime
  outboundStatus OutboundStatus?  @map("outbound_status")
  sendError      String?          @map("send_error")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([conversationId, timestamp])
  @@map("messages")
}

enum LeadEventType {
  LEAD_CREATED
  CONVERSATION_STARTED
  MESSAGE_RECEIVED
  QUALIFIED
  MEETING_SCHEDULED
  SALE_DETECTED
  REVENUE_DETECTED
  DISQUALIFIED
  /** Um lead desqualificado voltou a andar no funil (Fase 11). */
  REACTIVATED
}

model LeadEvent {
  id         String        @id @default(uuid())
  organizationId String    @map("organization_id")
  leadId     String        @map("lead_id")
  type       LeadEventType
  metadata   Json?
  occurredAt DateTime      @default(now()) @map("occurred_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  /**
   * Ordem de inserção real, para desempatar a linha do tempo. Vários eventos
   * de uma mesma mensagem compartilham o `occurredAt` dela (que vem do
   * WhatsApp, não do nosso relógio) e frequentemente também o `createdAt`,
   * que só tem precisão de milissegundos — sem este contador, o Postgres
   * devolvia ordem arbitrária e a tela chegava a mostrar a venda antes da
   * mensagem que a originou.
   */
  sequence   BigInt        @default(autoincrement())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@map("lead_events")
}

// ---------------------------------------------------------------------------
// Phase 5: Qualification & Sale — trigger phrases, classifier, revenue,
// manual corrections with audit trail
// ---------------------------------------------------------------------------

enum ClassificationTarget {
  QUALIFIED
  WON
}

/**
 * Deterministic, rule-based classification only (Section 62): a probabilistic
 * classifier is out of scope for this phase. Matching is case-insensitive,
 * word-boundary-aware substring — see docs/QUALIFICATION.md for the known
 * false-positive tradeoff this implies (Section 108) and why operators
 * should prefer distinctive multi-word phrases.
 */
model ClassificationRule {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  targetStatus   ClassificationTarget @map("target_status")
  phrase         String
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("classification_rules")
}

enum ClassifierType {
  RULE
  MANUAL
}

model Sale {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  /** One sale per lead in this phase — a lead is either won or not (Section 16). */
  leadId            String         @unique @map("lead_id")
  /** Cents, never float (Section 48). Null until a value can be confirmed — never guessed (Section 109). */
  amountCents       Int?           @map("amount_cents")
  classifierType    ClassifierType @map("classifier_type")
  /** The message whose trigger phrase caused this, when detected automatically. */
  evidenceMessageId String?        @map("evidence_message_id")
  detectedAt        DateTime       @map("detected_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  evidenceMessage Message?     @relation(fields: [evidenceMessageId], references: [id])

  @@index([organizationId])
  @@map("sales")
}

enum AuditAction {
  SALE_CREATED
  SALE_UPDATED
  SALE_DELETED
  ATTRIBUTION_CHANGED
  LEAD_STATUS_CHANGED
  LEAD_DISQUALIFIED
  LEAD_REACTIVATED
  CONNECTION_CHANGED
  /** Um operador da plataforma entrou na organização (Fase 9). Registrado sempre, sem exceção. */
  IMPERSONATION_STARTED
}

/** Section 65 — who changed what, with a before/after snapshot, for any manual correction. */
model AuditLog {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String      @map("user_id")
  entity         String
  entityId       String      @map("entity_id")
  action         AuditAction
  before         Json?
  after          Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 6: Meta Ads — connection, campaign hierarchy, spend sync
// ---------------------------------------------------------------------------

enum MetaConnectionStatus {
  CONNECTED
  DISCONNECTED
  /** Meta's error code 190 — the access token needs to be replaced (Section 53). */
  TOKEN_EXPIRED
  /** The last sync attempt failed for a reason other than an expired token. */
  SYNC_FAILED
}

model MetaConnection {
  id                   String               @id @default(uuid())
  organizationId       String               @unique @map("organization_id")
  /** Meta's ad account id, e.g. "act_123456789" — the routing key for every Graph API call this connection makes. */
  adAccountId          String               @map("ad_account_id")
  /** Required (unlike WhatsApp's optional token): every sync call needs it. Encrypted at rest — never sent back to the frontend. */
  accessTokenEncrypted String               @map("access_token_encrypted")
  status               MetaConnectionStatus @default(CONNECTED)
  lastSyncedAt         DateTime?            @map("last_synced_at")
  lastSyncError        String?              @map("last_sync_error")
  connectedAt          DateTime             @default(now()) @map("connected_at")
  disconnectedAt       DateTime?            @map("disconnected_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  /** Set only once CAPI is configured (Section: Fase 7 is a separate setup step from ads reporting). Null means events are recorded but never sent yet. */
  pixelId                  String?   @map("pixel_id")
  capiAccessTokenEncrypted String?   @map("capi_access_token_encrypted")
  capiConfiguredAt         DateTime? @map("capi_configured_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("meta_connections")
}

/**
 * `externalId` is Meta's own id — never used as our primary key (Section 47),
 * since Meta ids aren't guaranteed unique across the whole system the way a
 * UUID we mint ourselves is, and because we need a stable internal id that
 * survives even if Meta's id format or meaning ever changed.
 */
model Campaign {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  externalId     String    @unique @map("external_id")
  name           String
  status         String
  lastSyncedAt   DateTime  @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adSets       AdSet[]
  spend        AdSpend[]

  @@index([organizationId])
  @@map("campaigns")
}

model AdSet {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  externalId   String   @unique @map("external_id")
  name         String
  status       String
  lastSyncedAt DateTime @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id           String   @id @default(uuid())
  adSetId      String   @map("ad_set_id")
  externalId   String   @unique @map("external_id")
  name         String
  status       String
  lastSyncedAt DateTime @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  adSet AdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@index([adSetId])
  @@map("ads")
}

/**
 * Daily granularity at campaign level (Section 51/70: dashboards need to
 * filter investment by date range via `spend_date`). AdSet/Ad-level spend
 * history is deferred until Phase 8's actual drill-down reporting needs it
 * — see docs/META_ADS.md.
 */
model AdSpend {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  date        DateTime @db.Date
  spendCents  Int      @map("spend_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@map("ad_spend")
}

// ---------------------------------------------------------------------------
// Phase 7: Meta Conversions API — sending Lead/QualifiedLead/Purchase events
// back to Meta, deduplicated and retried with backoff
// ---------------------------------------------------------------------------

enum ConversionEventType {
  LEAD
  QUALIFIED_LEAD
  PURCHASE
}

enum ConversionEventStatus {
  /** Created, queued, not yet successfully sent. */
  PENDING
  /** Delivered to Meta — terminal, never re-sent (Meta itself dedupes on event_id, but we never even try again). */
  SENT
  /** At least one attempt failed and BullMQ scheduled a retry with backoff — not yet the final attempt. */
  RETRYING
  /** The job's last configured attempt failed — terminal until the organization reconfigures the connection (see MetaConnectionsService.connectCapi, which re-enqueues PENDING/FAILED events). */
  FAILED
}

/**
 * One row per (lead, event type) — enforced by `@@unique([leadId, type])`,
 * which doubles as the source of the deterministic `event_id` sent to Meta
 * (`buildMetaEventId`), so a duplicate domain trigger (or a BullMQ retry)
 * can never register a second event at Meta for the same lead/type. Only
 * ever created once a value is actually known — see docs/META_CAPI.md for
 * why a PURCHASE row is never created with a null valueCents.
 */
model ConversionEvent {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  leadId         String                @map("lead_id")
  type           ConversionEventType
  status         ConversionEventStatus @default(PENDING)
  /** Cents, never float (Section 48). Only set for PURCHASE. */
  valueCents     Int?                  @map("value_cents")
  currency       String?
  occurredAt     DateTime              @map("occurred_at")
  sentAt         DateTime?             @map("sent_at")
  lastError      String?               @map("last_error")
  attempts       Int                   @default(0)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, type])
  @@index([organizationId])
  @@map("conversion_events")
}
