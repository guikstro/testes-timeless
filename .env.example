# --- Database ---
DATABASE_URL=postgresql://tintim:tintim@localhost:5433/tintim

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=3001

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
WEB_APP_URL=http://localhost:3000

# --- Feature flags (Section 79) ---
WHATSAPP_INTEGRATION_ENABLED=false
META_INTEGRATION_ENABLED=false

# --- WhatsApp (Fase 3 — obtidas no Meta for Developers / WhatsApp Business Platform) ---
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Meta Ads / Conversions API (Fase 6-7 — obtidas no Meta Business Suite) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- Encryption at rest for stored OAuth tokens (Section 87) ---
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Webhooks (Section 85) ---
WEBHOOK_SIGNING_ALGORITHM=sha256
